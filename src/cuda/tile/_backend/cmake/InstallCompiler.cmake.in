cmake_policy(PUSH)
cmake_policy(VERSION 3.20)
# Resolve a relative --prefix like the install rules do.
get_filename_component(_package
    "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CUTILE_BACKEND_INSTALL_DIR@" ABSOLUTE)
set(_libdir "${_package}/_lib")
set(_noticedir "${_package}/_licenses/runtime")
set(_search_dirs "@_runtime_dirs@")
file(REMOVE_RECURSE "${_libdir}" "${_noticedir}")
file(GLOB _modules "${_package}/_compiler*.so" "${_package}/cpu/_cpu*.so")
file(GET_RUNTIME_DEPENDENCIES
    LIBRARIES ${_modules}
    DIRECTORIES ${_search_dirs}
    # Like manylinux, rely on the system C and C++ runtimes instead of vendoring them.
    PRE_EXCLUDE_REGEXES
        "^ld-linux.*" "^lib(c|m|dl|rt|pthread|util|resolv|stdc\\+\\+|gcc_s)\\.so\\."
    RESOLVED_DEPENDENCIES_VAR _libraries
    UNRESOLVED_DEPENDENCIES_VAR _missing)
if(_missing)
    message(FATAL_ERROR "Unresolved native compiler dependencies: ${_missing}")
endif()
find_program(_rpm rpm)
find_program(_dpkg dpkg-query)
set(_notices)
foreach(_library IN LISTS _libraries)
    file(REAL_PATH "${_library}" _real)
    get_filename_component(_name "${_library}" NAME)
    file(INSTALL "${_real}" DESTINATION "${_libdir}" TYPE FILE RENAME "${_name}")
    set(_files)
    if(_rpm)
        execute_process(COMMAND "${_rpm}" -qf --qf "%{NAME}" "${_real}"
            OUTPUT_VARIABLE _owner RESULT_VARIABLE _result ERROR_QUIET)
        if(_result EQUAL 0)
            execute_process(COMMAND "${_rpm}" -q --licensefiles "${_owner}"
                OUTPUT_VARIABLE _files COMMAND_ERROR_IS_FATAL ANY)
            string(REPLACE "\n" ";" _files "${_files}")
            list(APPEND _notices ${_files})
        endif()
    elseif(_dpkg)
        execute_process(COMMAND "${_dpkg}" -S "${_real}"
            OUTPUT_VARIABLE _owner RESULT_VARIABLE _result ERROR_QUIET)
        if(_result EQUAL 0)
            string(REGEX REPLACE ": /.*" "" _owner "${_owner}")
            string(STRIP "${_owner}" _owner)
            string(REGEX REPLACE ":[^:]+$" "" _owner "${_owner}")
            set(_files "/usr/share/doc/${_owner}/copyright")
            list(APPEND _notices "${_files}")
        endif()
    endif()
    if(NOT _files AND NOT _name MATCHES "^libgomp")
        message(WARNING
            "No runtime license metadata for ${_name}; verify its redistribution notices.")
    endif()
endforeach()
file(GLOB _gcc_notices "/usr/share/licenses/gcc/COPYING*")
list(APPEND _notices ${_gcc_notices})
list(REMOVE_DUPLICATES _notices)
foreach(_notice IN LISTS _notices)
    if(EXISTS "${_notice}" AND NOT IS_DIRECTORY "${_notice}")
        get_filename_component(_directory "${_notice}" DIRECTORY)
        get_filename_component(_owner "${_directory}" NAME)
        file(INSTALL "${_notice}" DESTINATION "${_noticedir}/${_owner}" TYPE FILE)
    endif()
endforeach()
file(GLOB _libraries "${_libdir}/*")
foreach(_binary IN LISTS _modules)
    get_filename_component(_directory "${_binary}" DIRECTORY)
    file(RELATIVE_PATH _relative "${_directory}" "${_libdir}")
    execute_process(COMMAND "@CUTILE_PATCHELF_EXECUTABLE@" --set-rpath
        "$ORIGIN/${_relative}" "${_binary}" COMMAND_ERROR_IS_FATAL ANY)
endforeach()
foreach(_binary IN LISTS _libraries)
    execute_process(COMMAND "@CUTILE_PATCHELF_EXECUTABLE@" --set-rpath
        "$ORIGIN" "${_binary}" COMMAND_ERROR_IS_FATAL ANY)
endforeach()
cmake_policy(POP)
